{
  "name": "@dataton/backend",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../../scripts/con-entorno.mjs tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node ../../scripts/con-entorno.mjs tsx src/db/migrate.ts",
    "semilla:autoridad": "node ../../scripts/con-entorno.mjs tsx src/scripts/semilla-autoridad.ts",
    "claves:autoridad": "node ../../scripts/con-entorno.mjs tsx src/scripts/generar-claves.ts",
    "test": "vitest run --passWithNoTests",
    "test:ataques": "vitest run --reporter=verbose ataques-k-anonimato publicacion agregar-periodos",
    "agregar": "node ../../scripts/con-entorno.mjs tsx src/contextos/transparencia/infraestructura/cli-agregar.ts",
    "sintetico": "node ../../scripts/con-entorno.mjs tsx src/scripts/sintetico.ts",
    "pdn:instantaneas": "node ../../scripts/con-entorno.mjs tsx ../../scripts/pdn/regenerar-instantaneas.mts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "@dataton/shared": "*",
    "altcha-lib": "^2.8.0",
    "sharp": "^0.35.5",
    "pdf-lib": "^1.17.1",
    "jszip": "^3.10.2",
    "file-type": "^22.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3"
  }
}
